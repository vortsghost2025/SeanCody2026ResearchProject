{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vortsghost2025/SeanCody2026ResearchProject/schemas/canonical-record.schema.json",
  "title": "Sean & Cody Research Canonical Record",
  "description": "Machine-validatable form of the canonical schema established in Research Session 003. This schema records claims without assuming that the claim content is true.",
  "type": "object",
  "required": [
    "record_id",
    "motif_cluster",
    "record_type",
    "motif",
    "earliest_surviving_source_date",
    "source_type",
    "evidence_class",
    "location",
    "negative_evidence",
    "session_added",
    "last_updated"
  ],
  "additionalProperties": false,
  "properties": {
    "record_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]+[a-z]?$"},
    "motif_cluster": {"type": "string", "minLength": 1},
    "record_type": {
      "type": "string",
      "enum": ["event", "artifact", "text", "map", "person", "hypothesis", "convergence", "testimony", "media", "expedition", "tradition", "category"]
    },
    "motif": {"type": "string", "minLength": 1},
    "culture": {"type": ["string", "null"]},
    "culture_notes": {"type": ["string", "null"]},
    "figure_or_source": {"type": ["string", "null"]},

    "claimed_event_date": {"type": ["string", "null"]},
    "claimed_event_date_confidence": {"$ref": "#/$defs/confidence"},
    "earliest_surviving_source_date": {"type": "string", "minLength": 1},
    "source_date_confidence": {"$ref": "#/$defs/confidence"},
    "source_type": {"type": "string", "minLength": 1},
    "evidence_class": {"$ref": "#/$defs/evidenceClass"},
    "evidence_class_notes": {"type": ["string", "null"]},

    "alien_or_modern_reinterpretation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "reinterpretation_claim": {"type": ["string", "null"]},
        "first_known_publication": {"type": ["string", "null"]},
        "first_known_author": {"type": ["string", "null"]},
        "first_known_date": {"type": ["string", "null"]},
        "evidence_class": {"anyOf": [{"$ref": "#/$defs/evidenceClass"}, {"type": "null"}]},
        "notes": {"type": ["string", "null"]}
      }
    },

    "oral_tradition_clocks": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "claimed_cosmological_time": {"type": ["string", "null"]},
        "estimated_material_culture_age": {"type": ["string", "null"]},
        "earliest_written_or_audio_recording": {"type": ["string", "null"]},
        "specific_wording_source_date": {"type": ["string", "null"]}
      }
    },

    "location": {
      "type": "object",
      "required": ["coordinate_type", "precision_km", "historical_place_name", "modern_place_name", "location_confidence"],
      "additionalProperties": false,
      "properties": {
        "coordinate_type": {
          "type": "string",
          "enum": ["site", "region", "culture_center", "publication_city", "national_centroid", "route", "unknown"]
        },
        "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
        "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
        "precision_km": {"type": ["number", "null"], "minimum": 0},
        "historical_place_name": {"type": ["string", "null"]},
        "modern_place_name": {"type": ["string", "null"]},
        "modern_country": {"type": ["string", "null"]},
        "location_confidence": {"$ref": "#/$defs/confidence"}
      }
    },

    "map_layers": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "contemporary_knowledge_map": {"type": ["string", "null"]},
        "physical_reconstruction": {"type": ["string", "null"]},
        "present_day_reference": {"type": ["string", "null"]},
        "plate_reconstruction": {"type": ["string", "null"]}
      }
    },

    "media_contamination_variables": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },

    "negative_evidence": {
      "type": "object",
      "required": ["expected_traces_if_true", "observed_traces", "absence_significance"],
      "additionalProperties": false,
      "properties": {
        "expected_traces_if_true": {"type": "array", "items": {"type": "string"}},
        "observed_traces": {"type": "array", "items": {"type": "string"}},
        "absence_significance": {"type": "string"}
      }
    },

    "connected_records": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "connection_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "DIRECT_CITATION",
          "PERSONAL_CONTACT",
          "RELIGIOUS_DIFFUSION",
          "MASS_MEDIA_EXPOSURE",
          "RETROACTIVE_REINTERPRETATION",
          "INTERNET_REPOST",
          "SHARED_SOURCE",
          "INDEPENDENT_PARALLEL",
          "TRANSLATION",
          "COLONIAL_RECORDING",
          "SPECULATIVE_SIMILARITY",
          "UNKNOWN"
        ]
      },
      "uniqueItems": true
    },

    "origin_confidence_stars": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "source_independence_stars": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "media_contamination_stars": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "earliest_verified_artwork": {"type": ["string", "null"]},
    "earliest_witness": {"type": ["string", "null"]},
    "earliest_standardized_image": {"type": ["string", "null"]},
    "last_major_mutation": {"type": ["string", "null"]},

    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "agent_tasks": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": ["string", "null"]},
    "session_added": {"type": "string", "minLength": 1},
    "last_updated": {"type": "string", "format": "date"}
  },

  "$defs": {
    "evidenceClass": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "E"]
    },
    "confidence": {
      "type": ["string", "null"],
      "enum": ["high", "moderate", "low", "unknown", null]
    },
    "source": {
      "type": "object",
      "required": ["source_id", "citation", "source_role", "access_status"],
      "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "citation": {"type": "string", "minLength": 1},
        "url": {"type": ["string", "null"], "format": "uri"},
        "source_role": {
          "type": "string",
          "enum": ["primary", "secondary", "tertiary", "reinterpretation", "critique", "catalogue", "map"]
        },
        "access_status": {
          "type": "string",
          "enum": ["verified_full_text", "verified_catalogue", "verified_excerpt", "citation_only", "unverified"]
        },
        "archive_url": {"type": ["string", "null"], "format": "uri"},
        "notes": {"type": ["string", "null"]}
      }
    }
  }
}
